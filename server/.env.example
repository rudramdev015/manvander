# MongoDB Atlas connection string (Database -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/houseofechoes?retryWrites=true&w=majority

# Long random string - used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (Dashboard home page has all three)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,https://your-site.vercel.app

PORT=4000
